{
  "schemaVersion": 1,
  "capabilitySet": "CEC-WR-01",
  "date": "2026-10-05",
  "runtimePackages": [
    "gsap",
    "three",
    "pixi.js",
    "lenis",
    "@theatre/core",
    "@theatre/studio",
    "@babylonjs/core",
    "@babylonjs/loaders",
    "@babylonjs/inspector"
  ],
  "globalCliPackages": [
    "@gltf-transform/cli",
    "gltfpack"
  ],
  "agentSkills": [
    {
      "source": "https://github.com/greensock/gsap-skills",
      "scope": "global",
      "agents": "all"
    }
  ],
  "mcpServers": [
    {
      "name": "spector",
      "source": "https://github.com/BabylonJS/Spector.js",
      "transport": "stdio",
      "command": "node",
      "args": [
        "<absolute-path-to-Spector.js>/mcp/dist/index.js"
      ],
      "status": "verify-local-before-use"
    }
  ],
  "browserTools": [
    {
      "name": "WebGPU Inspector",
      "source": "https://github.com/brendan-duncan/webgpu_inspector",
      "status": "verify-local-before-use"
    }
  ],
  "desktopTools": [
    {
      "name": "Blender",
      "channel": "LTS",
      "status": "verify-local-before-use"
    },
    {
      "name": "GIMP",
      "status": "verify-local-before-use"
    },
    {
      "name": "FFmpeg",
      "status": "verify-local-before-use"
    },
    {
      "name": "KTX-Software",
      "status": "verify-local-before-use"
    }
  ],
  "policy": {
    "preloadCapabilities": false,
    "shipOnlyTaskRequiredRuntime": true,
    "sealedEvidenceImmutable": true,
    "deterministicVerificationRequired": true,
    "selectionMode": "task-scoped-on-demand",
    "installOnlyWhenSelectedAndMissing": true
  },
  "integrationModel": {
    "agentNativeSkills": [
      "GSAP AI Skills"
    ],
    "mcp": [
      "Spector.js MCP"
    ],
    "shellCli": [
      "glTF Transform",
      "gltfpack",
      "FFmpeg",
      "KTX-Software"
    ],
    "browserDiagnostics": [
      "WebGPU Inspector"
    ],
    "desktopAuthoring": [
      "Blender",
      "GIMP"
    ],
    "projectRuntime": [
      "gsap",
      "three",
      "pixi.js",
      "lenis",
      "@theatre/core",
      "@theatre/studio",
      "@babylonjs/core",
      "@babylonjs/loaders",
      "@babylonjs/inspector"
    ]
  },
  "verification": {
    "command": "powershell -ExecutionPolicy Bypass -File tooling/creative-capabilities/verify-workstation.ps1",
    "policy": "verify-first-install-only-missing",
    "browserExtensionCheck": "manual"
  },
  "scope": "reusable-website-reconstruction",
  "currentConsumer": "HBC",
  "runtimePackagesAreCandidates": true
}
