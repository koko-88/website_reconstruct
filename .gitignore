# Dependencies and generated build output
node_modules/
dist/

# Provisional reusable-workstation bootstrap kept local, never project source
/package.json
/package-lock.json

# Test / acceptance outputs
artifacts/
test-results/
playwright-report/
blob-report/

# Local-only implementation fixtures and generated serving stage
local-fixtures/
public/fixtures/home/

# Local environment files
.env
.env.*
!.env.example

# Local mise overrides and machine-specific lock state
mise.local.toml
mise.local.lock
mise.*.local.toml
mise.*.local.lock

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
