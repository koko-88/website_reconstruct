    {
      "kind": "actor",
      "title": "Actor frontmatter",
      "closed": true,
      "fields": [
        {
          "name": "id",
          "required": true,
          "kind": "string",
          "pattern": "^ACT-[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        {
          "name": "type",
          "required": true,
          "kind": "const",
          "constValue": "actor"
        },
        {
          "name": "title",
          "required": true,
          "kind": "string",
          "minLength": 1
        },
        {
          "name": "status",
          "required": true,
          "kind": "enum",
          "values": [
            "draft",
            "active",
            "deprecated",
            "retired"
          ],
          "description": "Lifecycle of a product artifact."
        },
        {
          "name": "actor-kind",
          "required": true,
          "kind": "enum",
          "values": [
            "human",
            "external-system",
            "scheduled-process",
            "product"
          ]
        },
        {
          "name": "provenance",
          "required": false,
          "kind": "object",
          "description": "Evidence behind recovered knowledge. Set on recovered (brownfield) artifacts only.",
          "properties": [
            {
              "name": "provenance.source",
              "required": true,
              "kind": "string",
              "minLength": 1,
              "description": "Where the knowledge came from: a file path, a URL, a ticket reference, or 'interview: <person>'."
            },
            {
              "name": "provenance.confidence",
              "required": true,
              "kind": "enum",
              "values": [
                "high",
                "medium",
                "low"
              ],
              "description": "high: read directly from a specification scenario or a test. medium: inferred from structured prose. low: inferred from indirect evidence such as a variable name."
            },
            {
              "name": "provenance.recovered-from",
              "required": false,
              "kind": "enum",
              "values": [
                "observation",
                "inference",
                "interview",
                "documentation"
              ],
              "description": "How the knowledge was recovered from the evidence."
            }
          ]
        }
      ],
      "idPrefix": "ACT",
      "bodySections": [
        "Purpose",
        "Goals",
        "Responsibilities",
        "Boundaries"
      ]
    },
