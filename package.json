{
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/playwright": "^1.0.0",
    "@playwright/test": "^1.64.0",
    "@prodshape/cli": "^0.22.0",
    "@types/three": "0.186.0",
    "chromatic": "^18.12.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "gltfjsx": "6.5.3"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@pixi/react": "8.0.5",
    "@xstate/graph": "^3.0.4",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "motion": "12.43.0",
    "pixi.js": "8.22.0",
    "xstate": "^5.33.2"
  },
  "name": "ai-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "packages/*",
    "projects/*"
  ],
  "scripts": {
    "creative:build": "npm run build --workspace @ai-factory/creative-workbench",
    "creative:assets": "node packages/creative-assets/cli.mjs",
    "creative:dev": "npm run dev --workspace @ai-factory/creative-workbench",
    "creative:check": "node --test tooling/creative/route.test.mjs packages/creative-assets/pipeline.test.mjs",
    "creative:test": "npm run test --workspace @ai-factory/creative-workbench --",
    "creative:discover": "node tooling/creative/discover.mjs",
    "creative:route": "node tooling/creative/route.mjs",
    "creative:verify-media": "node --test packages/creative-assets/native-media.test.mjs",
    "creative:verify-assets": "node --test packages/creative-assets/native-assets.test.mjs"
  }
}
